# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — match node_modules at any depth, not just repo root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never committed. Example file IS committed
# (no secrets, just keys + format guidance for new envs).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor caches
.vscode/.last-target
.idea/

# Prisma — local dev SQLite artifacts. Postgres migrations DO get committed
# (Coolify deploy runs `prisma migrate deploy` from them).
prisma/dev.db
prisma/dev.db-journal

# hydra-418 measurement artifacts (raw per-load JSONL + markup dumps) — outputs, not source
subastas/scripts/audit/__snapshots__/
