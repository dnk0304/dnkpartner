# ================================
# Environment Configuration
# ================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control!

# ================================
# Required API Keys
# ================================

# OpenAI API Key (for GPT/DALL-E features)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Replicate API Token (for AI image generation models)
# Get yours at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Google API Key (for Google services)
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# ================================
# Optional API Keys (Video Features)
# ================================

# Runway ML API Key (for video generation)
# Get yours at: https://runwayml.com/
RUNWAY_API_KEY=

# Stability AI Video API Key (for video generation)
# Get yours at: https://stability.ai/
STABILITY_VIDEO_API_KEY=

# ================================
# Optional Server URLs (Self-hosted AI Models)
# ================================

# AnimateDiff Server URL (for video animation)
ANIMATEDIFF_SERVER_URL=

# SadTalker Server URL (for talking head generation)
SADTALKER_SERVER_URL=

# Wav2Lip Server URL (for lip sync)
WAV2LIP_SERVER_URL=

# ================================
# Trends Scraper — Etsy (Open API v3)
# ================================
# Etsy app keystring (the "API Key" / keystring from etsy.com/developers).
# Read-only public listing search (findAllListingsActive + batch enrich) needs
# ONLY this keystring in the x-api-key header — NO OAuth token is required.
# When set, the Etsy trends source switches from DataDome-blocked scraping to
# the official API automatically. Leave blank to fall back to proxy/scrape/mock.
# NOTE: new Etsy apps are PENDING manual review — the key returns HTTP 403
# ("API key not found or not active") until Etsy activates it.
ETSY_API_KEY=
# Alias accepted by the scraper (ETSY_API_KEY takes precedence if both set):
# ETSY_KEYSTRING=

# Optional residential/mobile proxy for the fallback scrape path (only used if
# ETSY_API_KEY is unset). Etsy hard-blocks datacenter IPs via DataDome.
# ETSY_PROXY_URL=
