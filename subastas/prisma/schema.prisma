enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  seoTitle          String?
  metaDescription   String?
  primaryKeyword    String?
  secondaryKeywords String[] @default([])
