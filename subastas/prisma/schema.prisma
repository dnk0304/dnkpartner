// ---------------------------------------------------------------------------
// Region €/m² benchmark (Phase 3 — Forge, 2026-07-16)
//
// Precomputed value-signal table. One row per published bucket:
//   (province, category, municipality) — municipality = '' for a
//   PROVINCE-LEVEL bucket (empty-string sentinel, NOT null, so the unique key
//   is deterministic and upsert works; SQL NULLs are distinct in a unique
//   index and would break both).
//
// Populated by POST /api/admin/benchmark/recompute (admin/cron), which reads
// the active+upcoming property pool, derives €/m² per row
// (valorSubasta||appraisalValue ÷ surfaceM2 — same as the card pill), trims
// outliers (plausibility band + 1.5×IQR) and stores the MEDIAN per bucket.
// A bucket is only written when it has >= MIN_SAMPLE comparables after
// trimming (min-sample honesty). See src/lib/benchmark.ts for the method.
//
// Precompute (not on-the-fly) chosen so the list API stays a single indexed
// batch lookup rather than a grouped percentile aggregation per request.
// Additive, standalone table — no FK to Auction (buckets outlive individual
// rows and are keyed by string province/category, matching the raw-SQL list
// route's own keys). Ken runs the migration + first recompute.
// ---------------------------------------------------------------------------

model RegionBenchmark {
  id           String @id @default(cuid())
  province     String
  category     String
  // '' = province-level bucket; otherwise the municipality name.
  municipality String @default("")

  // Comparables behind the median AFTER outlier trimming.
  sampleSize  Int
  // MEDIAN €/m² (whole euros) — never a mean (auction data is skew-heavy).
  medianEurM2 Float
  // Interquartile band + trimmed range, for "how spread out" context.
  p25EurM2    Float?
  p75EurM2    Float?
  minEurM2    Float?
  maxEurM2    Float?

  computedAt DateTime @default(now())

  @@unique([province, category, municipality])
  @@index([province, category])
}

// ---------------------------------------------------------------------------
// AuctionOutcomeStats — precomputed rollup for the /resultados registry
// (Forge, 2026-07-18). "Analyze everything": counts + money medians + discount
// by period × basis × geo × category × outcome, over ALL categories. NIGHTLY
// recompute on the scheduler (POST /api/admin/registro/recompute) — NEVER live
// (237k rows; the app had a pg-connection-exhaustion incident). The outcome
// bucket is the canonical auctionOutcome() taxonomy (src/lib/seo/auction-outcome.ts).
//
// Additive, standalone table — no FK to Auction (buckets are keyed by string
// dimensions and outlive individual rows). Empty-string sentinels ('') mark
// rollup levels (national geo / all-municipalities / all-categories) so the
// UNIQUE key is deterministic — the RegionBenchmark lesson (SQL NULLs distinct).
// Ken runs the migration + first recompute.
// ---------------------------------------------------------------------------

model AuctionOutcomeStats {
  id String @id @default(cuid())

  // Month bucket "YYYY-MM".
  period String
  // 'PUBLISHED' (on publishedAt) | 'CONCLUDED' (on endsAt). Both computed —
  // Dennis decision D3 (which the UI leads with) pending, so store both.
  periodBasis String
  // '' = national rollup; otherwise the province.
  province String @default("")
  // '' = province-level (or national) rollup; otherwise the municipality.
  municipality String @default("")
  // '' = all-categories rollup; otherwise the DB category label.
  category String @default("")
  // Canonical outcome bucket: VENDIDA | DESIERTA | CANCELADA |
  // FINALIZADA_SIN_RESULTADO | INDETERMINADO.
  outcome String

  // Always-emitted count of auctions in this bucket.
  count Int

  // Money medians — VENDIDA only, in CENTS. NULL when < MIN_MEDIAN_SAMPLE sales
  // (honest-NULL: a median of two sales is noise).
  soldPriceMedianCents BigInt?
  soldPriceP25Cents    BigInt?
  soldPriceP75Cents    BigInt?

  // Median discount (whole percent; positive = sold BELOW the reference),
  // VENDIDA only, honest-NULL below the sample floor.
  discountToAppraisalMedian    Float?
  discountToValorSubastaMedian Float?

  computedAt DateTime @default(now())

  @@unique([period, periodBasis, province, municipality, category, outcome])
  @@index([periodBasis, province, category, outcome])
  @@index([province, municipality])
  @@index([outcome])
}

// ---------------------------------------------------------------------------
// NoticiaMonthly — auto-generated monthly per-province recap ARTICLE (Forge,
// 2026-07-20). One row per province × month; the Python scheduler job
// generate_monthly_noticias() UPSERTs it on the [period, province] key after
// the nightly AuctionOutcomeStats recompute. "Publish" = the row exists —
// Next renders it dynamically (ISR), so a new month surfaces with NO redeploy.
//
// News semantics: statsJson is an IMMUTABLE SNAPSHOT of the numbers at
// generation time — a June article never changes if the registry is re-scraped
// later. The scheduled gate only writes months that have NO rows yet, so normal
// operation is generate-once; the UPSERT exists for safe re-runs / manual
// --noticias-once corrections. Bilingual in one row (es + en) to halve row
// count and keep the pair atomic (~52 rows/month, growing).
//
// Additive, standalone table, no FK (mirrors AuctionOutcomeStats). Ken runs the
// migration (with the wave127 idle-in-transaction pre-check).
// ---------------------------------------------------------------------------
model NoticiaMonthly {
  id       String @id @default(cuid())
  period   String // "YYYY-MM" — the reported (closed) month
  province String // canonical province slug — matches src/lib/seo/slugs.ts PROVINCE_SLUGS

  // Bilingual copy in one row (es primary + en). Rendered verbatim.
  titleEs String
  titleEn String
  proseEs String @db.Text
  proseEn String @db.Text

  // Immutable snapshot of the numbers the copy + charts were built from. UI
  // renders charts from this single-row read — no cross-table join at request
  // time (the request-path-reads-only-indexed rule). Shape is defined by the
  // Python job + mirrored in src/lib/noticias-monthly.ts (NoticiaStats).
  statsJson Json

  // Thin-content guard: false when intake == 0 AND every concluded bucket == 0
  // (a dead province-month) so Google is never fed an empty page. The route
  // 404s / noindexes unpublished rows. Most province-months are true.
  published   Boolean  @default(true)
  generatedAt DateTime @default(now())

  @@unique([period, province])
  @@index([province, period])
  @@index([period])
  @@index([published, period])
}
