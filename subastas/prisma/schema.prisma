// dnksubastas — Prisma schema for Postgres (Wave 1 Forge, 2026-05-29).
//
// Strategy: reconciled with live SQLite shape FIRST (so the baseline migration
// matches what we're about to ETL into), THEN layered the new Wave 1 schema on
// top (history, outbox, follow prefs, upgraded Notification, structured
// suspension fields).
//
// The legacy AuctionStatus enum values (PRE_AUCTION / ACTIVE / FINISHED /
// SUSPENDED / CANCELLED) are KEPT for now — Ghost is still writing some of
// them and the ETL needs to land them as-is. They get dropped in a later wave
// once Ghost stops emitting them AND the count == 0.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Core auction data
// ---------------------------------------------------------------------------

model Auction {
  id           String        @id @default(cuid())
  boeId        String        @unique
  // Nullable so the scraper can write an honest NULL when no title is parsed,
  // letting the app synthesise a display title. NEVER store the literal "Unknown".
  title        String?
  category     String
  province     String
  municipality String?
  status       AuctionStatus @default(CELEBRANDOSE)
  auctionType  String?       @default("JUDICIAL")

  // Scope enforcement (wave155, 2026-07-28). Reversible soft-hide: only
  // property/land + vehicle auctions that carry REAL information are shown.
  // Out-of-scope (movable goods, rights) and empty-shell rows (no real data —
  // just a price/placeholder title, e.g. the €55 PLABI "ACTIVO FRISU") are
  // flagged inScope=false and dropped from every catalog surface (list, detail,
  // search, sitemap, index) — NOT deleted, so a wrong call is a one-row UPDATE
  // to reverse. `scopeReason` records WHY it was hidden:
  //   'movable' | 'rights' | 'unclassified' | 'empty-shell'.
  // Governing principle (Dennis 2026-07-28): DATA QUALITY, not just category —
  // a dead source link ALONE never hides a row (real-data-but-dead-link rows,
  // e.g. the suspended Las Palmas auction, stay KEPT + frozen); only a row that
  // never captured real information is an empty shell.
  inScope      Boolean       @default(true)
  scopeReason  String?

  // Core auction values
  // Nullable: the real Tasación comes from the BOE detail page; when genuinely
  // absent the value is NULL (honest). NEVER coerce a missing value to 0.
  appraisalValue Float?
  // Valor subasta — DISTINCT from appraisalValue (Tasación). BOE judicial pages
  // routinely render "Tasación 0,00 €" while carrying the real reference figure
  // under "Valor subasta"; we now store the two SEPARATELY so the card can show
  // Tasación + Valor subasta + Cantidad reclamada as three distinct numbers.
  // Nullable + honest-NULL: NULL when the BOE page carries no Valor subasta.
  valorSubasta   Float?
  currentBid     Float?
  minimumBid     Float?
  depositAmount  Float?
  claimedAmount  Float?
  finalBid       Float?
  bidIncrement   Float?

  // Court and legal info
  courtName       String?
  procedureNumber String?
  boeLink         String?
  auctionId       String?
  lotNumber       String?
  boeAnnouncement String?

  // Multi-lot split provenance (#14). When BOE declares an auction's lotes are
  // sold separately ("...se subastan de forma separada/independiente"), the
  // scraper splits it into one INDEPENDENT Auction row per lote, keyed
  // boeId = "<sourceIdSub>-L<loteNumber>". These two nullable columns record
  // where a split row came from; both are NULL for ordinary single auctions.
  // Additive, nullable, no backfill in the migration. The composite boeId is
  // self-describing too, but explicit columns keep the backfill + any
  // "other lotes of this auction" query trivial (hence the index).
  sourceIdSub String?
  // BigInt: BOE legacy lote identifiers can be 15-digit numbers (e.g.
  // 120240073010647) that overflow PG int4 (max 2.1B). Widened to BIGINT in
  // wave13-hotfix migration 20260602_widen_lote_number_bigint. Existing int
  // values fit in BIGINT — additive, lossless. Adapter writes Python int
  // (psycopg2 handles BIGINT natively).
  loteNumber  BigInt?

  // Sale result capture (#sale-results, migration 20260717). Additive +
  // honest-NULL: every column stays NULL until a result-check pass determines
  // the outcome. The scraper's result-check code is column-guarded, so these
  // names + the SaleResult enum labels are reproduced VERBATIM by the Python
  // adapter. No backfill in the migration — resultCheckedAt doubles as the
  // backfill resume cursor.
  saleResult          SaleResult? // ADJUDICADA | DESIERTA | SIN_RESULTADO; honest-NULL until determined
  soldPrice           BigInt? // winning bid in CENTS (BigInt); NULL for DESIERTA or amount-hidden
  soldDate            DateTime? // = endsAt (BOE exposes no true sale timestamp)
  resultCheckedAt     DateTime? // stamped now() on every result-check pass; also the backfill resume cursor
  resultCheckAttempts Int         @default(0) // running attempt count; at attempt-cap the pass sets saleResult=SIN_RESULTADO

  // Dates and times
  publishedAt DateTime
  // opensAt: the auction's opening / "Fecha de inicio" — when a PROXIMA_APERTURA
  // pre-auction begins live bidding. Nullable (additive migration; live rows
  // pre-date the column). Drives the time-driven PROXIMA_APERTURA->CELEBRANDOSE
  // promotion job in scheduler.promote_pending_auctions.
  opensAt     DateTime?
  endsAt      DateTime?
  endDateTime DateTime?

  // Location data
  latitude  Float?
  longitude Float?
  address   String?

  // Geocode attempt tracking (geocode-drain poison-pill fix). The 10-min
  // geocode drain (scraper.tasks.backfill_tasks.geocode_missing_coordinates)
  // SELECTs NULL-coord rows with no ORDER BY and no failure memory, so a small
  // head-of-line cluster of un-findable addresses (Nominatim ZERO_RESULTS) was
  // re-selected every cycle forever — the 470+ findable rows behind them were
  // never reached. These two columns give the drain a memory:
  //   geocodeAttemptedAt — stamped now() on EVERY attempt (hit OR miss). The
  //     selection query orders NULLS FIRST and excludes rows attempted within
  //     the last 7 days, so never-tried rows go first, recently-failed rows
  //     cool down, and the LIMIT window always advances past the poison cluster.
  //   geocodeAttempts    — running count, for observability / future backoff.
  // Both nullable/defaulted-additive: ~237k existing rows take the column
  // default with NO backfill, NO index (metadata-only ALTER, safe at this row
  // count — precedent: add_boe_tab_urls / add_user_email_prefs). An un-findable
  // address stays NULL-coord (honest, no pin) — we never fabricate coords;
  // these columns only stop it BLOCKING findable rows.
  geocodeAttemptedAt DateTime?
  geocodeAttempts    Int       @default(0)

  // Property details
  propertyType        String?
  lotDescription      String?
  propertyDescription String?

  // Legal and encumbrance details
  charges          String?
  chargesDetail    String?
  possessionStatus String?
  visitable        String?

  // #16 / #17 — pujas (bids) + occupancy, parsed from the BOE detail page.
  // All three additive + nullable; live rows pre-date them and a bounded
  // backfill fills the active pool. NULL means "not yet scraped / unknown",
  // NEVER a default — the card layer must not render a misleading badge when
  // the field is simply unscraped.
  //
  // #16 pujaStatus: normalized bid state read from the BOE "Pujas" tab.
  //   CON_PUJA  = the auction (or split-lote) has at least one bid
  //   SIN_PUJA  = the Pujas tab explicitly says "Sin puja" (no bids yet)
  //   null      = couldn't determine (cancelled, umbrella-only, parse miss)
  pujaStatus       String?
  // #16 currentBidAmount: the highest bid in CENTS (int) when BOE shows the
  // figure publicly ("Puja máxima de la subasta 92.234,16 €" -> 9223416).
  // BigInt for safety/consistency with the wave13 loteNumber lesson: a bid in
  // cents on a high-value property can exceed int4's 2.1B ceiling (~21M EUR).
  // null when BOE has bids but hides the amount behind login
  // ("Con puja (inicie sesión para consultar el importe)") -> pujaStatus is
  // still CON_PUJA with a null amount, per the brief.
  currentBidAmount BigInt?
  // #17 occupancy: normalized "Situación posesoria" from the detail page.
  //   OCUPADO    = "Ocupantes..." / "Ocupada" / "Ocupado"
  //   NO_OCUPADO = "Sin ocupantes" / "No ocupado" / "Libre"
  //   NO_CONSTA  = "Se desconoce" / "No consta"
  //   null       = the BOE page carries no Situación posesoria field at all
  occupancy        String?

  // Cadastral / registry / contact
  cadastralRef  String?
  cadastralData String?
  registryId    String?
  registryInfo  String?
  contactInfo   String?

  // Document-archive wave (2026-06-03) — discrete "Datos del bien" fields
  // that today get lost inside the `lotDescription` blob. All additive +
  // nullable; NULL means "not yet scraped / not present on BOE" (never a
  // default, never backfilled-as-zero — same convention as pujaStatus/
  // occupancy). Ghost parses + writes these via the adapter's information_
  // schema guard so the migration is safe-to-apply-later.
  //   postalCode          — código postal del bien
  //   idufir              — IDUFIR (registry-wide unique identifier)
  //   registryInscription — "Inscripción registral" string
  //   legalTitle          — "Título jurídico" string
  //   bienLocalidad       — bien-level locality (distinct from listing-
  //                         level `municipality` so a bien in Móstoles on a
  //                         juzgado-de-Madrid listing doesn't clobber the
  //                         court's location).
  //   bienProvincia       — bien-level province (same rationale).
  //   viviendaHabitual    — true / false / NULL (BOE checkbox: "Vivienda
  //                         habitual del deudor").
  postalCode          String?
  idufir              String?
  registryInscription String?
  legalTitle          String?
  bienLocalidad       String?
  bienProvincia       String?
  viviendaHabitual    Boolean?

  // surfaceM2 (2026-06-19) — building surface area in SQUARE METRES, parsed by
  // Ghost from the registry/bien free-text prose (digit "11,76 M2" and Spanish
  // number-word "veinticinco metros y setenta y seis decímetros cuadrados"
  // forms). NOT a structured BOE tab cell. Honest-NULL when no parseable
  // surface (or only agrarian "cabida" áreas/centiáreas) is present — never 0,
  // never fabricated. Float (m² can be 11.76 / 52.50). €/m² is DERIVED at read
  // time (valorSubasta ÷ surfaceM2, else appraisalValue ÷ surfaceM2) — no stored
  // column, so it can never go stale when either input changes.
  surfaceM2 Float?

  // Vehicle fields (wave E2, 2026-06-07) — make/model/year for VEHICLE-category
  // auctions (Turismos, Motocicletas, Camiones, …). Source: BOE/SEGSOCIAL/PLABI
  // vehicle ficha pages (Ghost E1 extracts; this column set lands the storage).
  // All additive + nullable:
  //   - non-VEHICLE rows are always NULL on all three (real-estate has no
  //     make/model — same posture as bienLocalidad on a vehicle row).
  //   - VEHICLE rows pre-backfill are NULL until Ghost extracts.
  //   - VEHICLE rows where the ficha lacks a field stay NULL on that specific
  //     field (honest-NULL — never coerce to "Desconocido" / "—").
  // The auctionCardTitle helper consumes these so a vehicle card reads
  // "Turismo - SEAT León en Murcia" when make+model are present, falling
  // through to the existing "{Tipo} en {town}" phrasing otherwise.
  // vehicleYear is INTEGER (Int) — a 4-digit year fits trivially in int4;
  // the wave13 BIGINT lesson (loteNumber) does not apply here.
  vehicleMake  String?
  vehicleModel String?
  vehicleYear  Int?

  // Property-portal attributes (Phase 1, 2026-07-11) — idealista-style facts
  // parsed by Ghost's property_attribute_parser from the SAME bien/registry
  // prose we already store (lotDescription + propertyDescription + cadastralData
  // + title), no new fetch. All additive + nullable + HONEST-NULL: absence of a
  // mention is NULL, never 0 / false ("the listing doesn't say" ≠ "there are
  // zero bedrooms"). Booleans persist an explicit false ONLY on a negated
  // mention ("sin garaje"); otherwise NULL. A bare singular room noun counts as
  // 1 only inside a distribución enumeration; unqualified plurals stay NULL.
  bedrooms       Int?
  bathrooms      Int?
  hasTerrace     Boolean?
  hasGarden      Boolean?
  hasGarage      Boolean?
  hasStorageRoom Boolean?
  floorLevel     String?

  // Catastro DNPRC enrichment (Phase 1, 2026-07-11) — from the free OVC
  // Consulta_DNPRC web service (DG Catastro, Ley 18/2015) keyed by the 20-char
  // cadastralRef. catastroYearBuilt = debi.ant (año construcción), catastroUse =
  // debi.luso (uso principal). superficie (debi.sfc) fills the EXISTING surfaceM2
  // ONLY where currently NULL (scraped values are never overwritten).
  // catastroCheckedAt timestamps the last DNPRC lookup so dead refs (cod 4/5)
  // are not re-hammered daily (re-checked weekly at most). Honest-NULL.
  catastroYearBuilt Int?
  catastroUse       String?
  catastroCheckedAt DateTime?

  // Media
  pdfUrl   String?
  imageUrl String?

  // Lifecycle tracking
  source         String    @default("BOE")
  courtReference String?
  edictUrl       String?
  originalSource String?
  transitionedAt DateTime?

  // Reconciled-with-live-DB columns (existed in SQLite, missing from schema).
  mapUrl        String?
  streetViewUrl String?
  placeUrl      String?
  directionsUrl String?

  // Wave 1 new structured fields — feed suspension/reschedule notifications
  // and the freshness/cleanup UI. Populated by Ghost's scrapers.
  suspensionReason String?
  resumeAt         DateTime?
  // BOE-sourced suspension reason text, parsed from
  // "temporalmente suspendida (<motive>)" on the detail page. Distinct from
  // `suspensionReason` (internal WITHDRAWN_PRE_AUCTION sentinel). NULL = BOE
  // stated no parenthetical motive — NEVER a default.
  suspensionMotive String?
  lastVerifiedAt   DateTime?

  // Statistics
  viewCount     Int @default(0)
  favoriteCount Int @default(0)

  // Relations
  favorites     Favorite[]
  notifications Notification[]
  statusHistory AuctionStatusHistory[]
  bidHistory    AuctionBidHistory[]
  outboxEvents  EventOutbox[]
  // Document-archive wave (2026-06-03). One Auction has many AuctionDocument
  // rows (nota simple, edicto, anexo, pliego, plus the single snapshot row).
  documents     AuctionDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
  @@index([status])
  @@index([publishedAt])
  @@index([source])
  @@index([propertyType])
  @@index([municipality])
  // Scope soft-hide gate (wave155): every catalog surface ANDs `inScope = true`.
  @@index([inScope])
  // Wave 1 composite/partial indexes for the live-state queries.
  @@index([status, endsAt])
  @@index([endsAt])
  // Promotion query: PROXIMA_APERTURA rows whose opensAt has arrived.
  @@index([status, opensAt])
  @@index([municipality, status])
  // #14 split provenance: "all lotes of BOE auction X" + backfill lookups.
  @@index([sourceIdSub])
  // Registry /resultados browse (2026-07-18): filter concluded rows by
  // province + category + terminal status, ordered by sale date. province
  // leads (most selective for the region-scoped browse UI); saleResult /
  // soldPrice are residual-filtered on the already-narrowed set.
  @@index([province, category, status, soldDate])
}

// ---------------------------------------------------------------------------
// AuctionDocument — document-archive wave (2026-06-03)
//
// BOE exposes multiple PDFs per auction (NOTA_SIMPLE on ver=3, EDICTO on
// ver=1, plus possible ANEXO/PLIEGO). Ghost mirrors each PDF to
// /data/auction-docs/<safeKey(boeId)>/<filename>.pdf and writes one row per
// document here. We keep both the BOE `officialUrl` (so the user can always
// follow upstream) AND the local `storedPath` (so the app can serve
// authoritatively + survive BOE link rot).
//
// A single per-auction "ver=3" snapshot HTML-print-to-PDF is also persisted
// under sentinel kind="snapshot", idDoc="SNAPSHOT" — the @@unique on
// (auctionId, idDoc) collapses re-scrapes to ONE snapshot row so the file is
// overwritten in-place (Ken's storage-growth flag).
//
// STORAGE CONTRACT: storedPath is RELATIVE — `<safeKey(boeId)>/<filename>.pdf`.
// Resolved at request time via AUCTION_DOCS_DIR (see
// subastas/src/lib/auction-docs/storage.ts). The serve route validates the
// stored path before reading from disk so a malformed row can never escape
// the storage root.
// ---------------------------------------------------------------------------

model AuctionDocument {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  // BOE "tipo" label normalized by Ghost.
  //   NOTA_SIMPLE | EDICTO | ANEXO | PLIEGO | SNAPSHOT | OTRO
  docType     String
  // BOE link text, e.g. "NOTA SIMPLE REGISTRAL". Free-form, preserved verbatim.
  title       String
  // The verDocumento.php URL (or ver=3 detail URL for snapshots). Kept so the
  // user can fall back to upstream when our cached file is unavailable.
  officialUrl String?
  // BOE idDoc query param — the dedup key. Snapshots use the sentinel
  // "SNAPSHOT" so the @@unique collapses re-scrapes to one snapshot row.
  idDoc       String?
  // Relative path under AUCTION_DOCS_DIR, e.g. "BOE-B-2025-12345/nota.pdf".
  // NULL when we have an officialUrl but haven't (yet) cached the file.
  storedPath  String?
  // "download" (an actual BOE-served PDF) | "snapshot" (our HTML-print-to-PDF).
  kind        String  @default("download")
  // Optional metadata; sizeBytes fits in Int (PDFs < 2 GB).
  mimeType    String?
  sizeBytes   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dedup: one row per (auction, BOE idDoc). Snapshots dedup via the sentinel
  // idDoc="SNAPSHOT" so a re-scrape upserts the same row, overwriting the
  // single per-auction snapshot file in place.
  @@unique([auctionId, idDoc])
  @@index([auctionId])
}

// ---------------------------------------------------------------------------
// Identity, billing, sessions
// ---------------------------------------------------------------------------

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  name              String?
  phone             String?
  emailVerified     DateTime?
  image             String?
  tier              UserTier           @default(FREE)
  trialStartDate    DateTime?
  trialEndDate      DateTime?
  hasUsedTrial      Boolean            @default(false)
  // Email preferences (settings surface only — NOT yet wired to any send-path).
  // Added 2026-06-08 (account panel wave 1). Default ON for all rows.
  prefNewsletter    Boolean            @default(true) // boletín de novedades
  prefWeeklyNoNew   Boolean            @default(true) // aviso semanal sin nuevas subastas
  prefRadar         Boolean            @default(true) // radar de subastas
  alerts            Alert[]
  favorites         Favorite[]
  notifications     Notification[]
  subscription      Subscription?
  pushSubscriptions PushSubscription[]
  accounts          Account[]
  sessions          Session[]
  createdAt         DateTime           @default(now())
}

model Alert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reconciled-with-live-DB columns (existed in SQLite via the runtime
  // ALTER TABLE hack we just deleted; now real first-class schema).
  name         String?
  source       String?
  propertyType String?
  province     String?
  municipality String?
  auctionType  String?
  statuses     String? // CSV of AuctionStatus values
  keywords     String? // CSV
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  // Legacy filters
  category String?
  minPrice Float?
  maxPrice Float?

  // Notification preferences
  notificationType String  @default("grouped") // individual | grouped
  active           Boolean @default(true)

  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([active])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  // Feature #10: Whop linkage. Authoritative tier writes come from the Whop
  // webhook; we key by whopMembershipId on every event. whopPlanId / whopUserId
  // are recorded for support + future plan-tier remapping.
  whopMembershipId     String?   @unique
  whopPlanId           String?
  whopUserId           String?
  status               String
  tier                 UserTier
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([whopUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Favorites — extended with per-event notify prefs (Wave 1)
//
// Decision (Dennis D5): extend Favorite rather than create a separate
// AuctionFollow table. One relation per (user, auction), prefs sit beside.
// ---------------------------------------------------------------------------

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  auctionId String
  notes     String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  // Wave 1 follow / notify preferences.
  notifyOnGoLive     Boolean @default(true)
  notifyOnBid        Boolean @default(true)
  notifyOnStatus     Boolean @default(true)
  notifyOnSuspension Boolean @default(true)
  notifyOnResume     Boolean @default(true)
  notifyOnFinish     Boolean @default(true)
  channels           String  @default("email,inapp") // CSV: email,push,inapp
  quietHoursStart    Int?
  quietHoursEnd      Int?

  createdAt DateTime @default(now())

  @@unique([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}

// ---------------------------------------------------------------------------
// Notifications — upgraded for Wave 2 dispatcher (still no worker this wave)
// ---------------------------------------------------------------------------

enum NotificationType {
  NEW_MATCH
  GO_LIVE
  NEW_BID
  STATUS_CHANGE
  SUSPENDED
  RESUMED
  ENDING_SOON
  FINISHED
  CANCELLED
}

enum NotificationChannel {
  email
  push
  inapp
}

model Notification {
  id        String  @id @default(cuid())
  userId    String
  alertId   String?
  auctionId String
  read      Boolean @default(false)

  // Wave 1 upgrade.
  type             NotificationType    @default(NEW_MATCH)
  channel          NotificationChannel @default(inapp)
  payload          Json?
  deliveredAt      DateTime?
  failureReason    String?
  deliveryAttempts Int                 @default(0)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert   Alert?   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  auction Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  sentAt  DateTime @default(now())

  // Idempotency key (wave113, 2026-06-21): one row per (alert, auction, channel)
  // so the alert-email route can ON CONFLICT DO NOTHING and never re-email a
  // property it already sent. Migration: 20260621_notification_dedup_unique.
  // NOTE: alertId is nullable; Postgres treats NULLs as distinct in a UNIQUE
  // constraint, but the alert-email writer always supplies a concrete alertId.
  @@unique([alertId, auctionId, channel])
  @@index([userId])
  @@index([alertId])
  @@index([auctionId])
  @@index([read])
  // Inbox feed: latest unread first by user.
  @@index([userId, read, sentAt(sort: Desc)])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Wave 1 history + outbox tables (append-only; outbox has dedupe key)
// ---------------------------------------------------------------------------

model AuctionStatusHistory {
  id         String         @id @default(cuid())
  auctionId  String
  auction    Auction        @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  fromStatus AuctionStatus?
  toStatus   AuctionStatus
  changedAt  DateTime       @default(now())
  source     String         @default("scraper") // scraper | manual
  reason     String? // suspension reason (text)
  resumeAt   DateTime? // reschedule target
  detectedBy String? // task name that detected the change

  @@index([auctionId])
  @@index([changedAt])
  @@index([auctionId, changedAt(sort: Desc)])
}

model AuctionBidHistory {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bid       Float
  bidType   String   @default("current") // current | final
  seenAt    DateTime @default(now())
  source    String   @default("scraper")

  @@index([auctionId])
  @@index([seenAt])
  @@index([auctionId, seenAt(sort: Desc)])
}

model EventOutbox {
  id          String    @id @default(cuid())
  auctionId   String?
  auction     Auction?  @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  eventType   String // e.g. AUCTION_BID_CHANGED, AUCTION_STATUS_CHANGED, AUCTION_SUSPENDED…
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  // Dedupe key: e.g. `${auctionId}:${eventType}:${bidOrStatus}`. Wave 2
  // dispatcher uses this to skip duplicates.
  dedupeKey   String?   @unique

  @@index([auctionId])
  @@index([eventType])
  @@index([createdAt])
  @@index([processedAt, createdAt])
  @@map("event_outbox")
}

