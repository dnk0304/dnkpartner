# =============================================================
# DNK Partner — environment variables
#
# Copy to .env.local for local dev (Next.js loads .env.local automatically)
# or set in your hosting provider's env panel for production (Coolify, etc).
# Never commit real values — .env* is gitignored.
# =============================================================

# --- Database -------------------------------------------------
# Production: PostgreSQL on Hetzner via Coolify-managed instance.
# Format: postgresql://USER:PASS@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/dnkpartner"
# LOCAL Product Factory run: use a LOCAL DB — never point a test run at prod.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dnkpartner_local"
# Then: npx prisma migrate dev   (creates DB + applies factory migrations)
# Docker fallback if no local Postgres:
#   docker run --name dnkpf-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=dnkpartner_local -p 5432:5432 -d postgres:16

# --- Product Factory LLM backend ------------------------------
# The factory runner authenticates on the Claude Code SUBSCRIPTION already
# logged in on this machine — $0 per run, NO paid Anthropic key needed locally.
#   FACTORY_LLM_BACKEND=local-cli   (DEFAULT — shells out to the `claude` CLI)
#   FACTORY_LLM_BACKEND=anthropic-sdk  (DORMANT server/OAuth path; needs
#                                       ANTHROPIC_API_KEY — do not set locally)
# The ONLY local prerequisite is that Claude Code is logged in (`claude` works).
# Optional: override the CLI binary path if it isn't on PATH:
#   FACTORY_CLAUDE_BIN="C:\\path\\to\\claude.cmd"
FACTORY_LLM_BACKEND="local-cli"
# Do NOT set ANTHROPIC_API_KEY for the local run — the CLI handles auth.

# --- Auth secrets ---------------------------------------------
# Generate fresh per environment: `openssl rand -hex 32`
# Rotating these invalidates every existing session — plan migrations.
JWT_SECRET="change-me-32-bytes"
JWT_REFRESH_SECRET="change-me-another-32-bytes"

# --- Email (Resend) -------------------------------------------
# Sending domain must be verified in the Resend dashboard with DKIM CNAMEs
# added to DNS. Currently unused — registration was removed in the 2026-05-28
# lockdown, so no transactional emails fire from this app. Keys kept for
# future portfolio products that may send.
RESEND_API_KEY=""
EMAIL_FROM="DNK Partner <hello@dnkpartner.com>"
EMAIL_REPLY_TO="support@dnkpartner.com"

# --- App URL --------------------------------------------------
# Used in email links (verify, password reset). Must be the public origin
# without trailing slash.
NEXT_PUBLIC_APP_URL="https://dnkpartner.com"

# --- Google OAuth ---------------------------------------------
# Dennis must create a NEW Google Cloud OAuth client for dnkpartner.com —
# the ComputerCaller client cannot be reused (each domain needs its own).
# Redirect URI to register in Google Cloud Console:
#   https://dnkpartner.com/api/auth/google/callback
# (plus http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional — defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback.
# Override only if you're proxying or want a different path.
GOOGLE_REDIRECT_URI=""

# --- Login allowlist ------------------------------------------
# Comma-separated list of emails permitted to authenticate via either
# email/password or Google OAuth. Checked BEFORE the DB lookup so the timing
# leaks nothing, and rejects mirror the wrong-password 401 to keep the list
# invisible from outside. Empty list = nobody can log in. Falls back to
# dennis.kotlenko@gmail.com when unset (dev convenience).
ALLOWED_LOGIN_EMAILS="dennis.kotlenko@gmail.com"
